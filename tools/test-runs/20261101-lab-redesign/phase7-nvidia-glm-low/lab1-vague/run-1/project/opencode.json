{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "webfetch": "ask"
  },
  "instructions": [
    "AGENTS.md"
  ],
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "title": {
      "disable": true
    }
  },
  "provider": {
    "nvidia": {
      "models": {
        "z-ai/glm-5.3-flash": {
          "options": {
            "reasoningEffort": "low"
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    }
  }
}