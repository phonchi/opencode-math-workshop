跑一個不同隨機種子的快速檢查，確認結果不是湊巧（不改 `lab2_auc.py`）：
$ uv run python -c "
import pandas as pd, numpy as np
from sklearn.model_selection import StratifiedKFold
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import roc_auc_score
X = pd.read_csv('data/orders.csv'); y = pd.read_csv('data/orders_complaint.csv')['complaint'].to_numpy()
for seed in [0, 1, 7, 42]:
    cv = StratifiedKFold(5, shuffle=True, random_state=seed)
    out = {}
    for tr, te in cv.split(X, y):
        sc = StandardScaler().fit(X.iloc[tr]); Ztr = sc.transform(X.iloc[tr]); Zte = sc.transform(X.iloc[te])
        p = PCA(5).fit(Ztr); A, B = p.transform(Ztr), p.transform(Zte)
        for n in [3, 4, 5]:
            c = LogisticRegression(max_iter=1000).fit(A[:, :n], y[tr])
            out.setdefault(n, np.zeros(len(y)))[te] = c.predict_proba(B[:, :n])[:, 1]
    print(seed, {n: round(roc_auc_score(y, out[n]), 4) for n in [3, 4, 5]})
"
