import numpy as np
import pandas as pd
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler

df = pd.read_csv('data/shops_daily.csv')
X = StandardScaler().fit_transform(df)
feat = [c for c in df.columns if df[c].std() > 0]

lab10 = KMeans(10, random_state=0, n_init=10).fit_predict(X)
cent10 = np.array([X[lab10 == c].mean(axis=0) for c in range(10)])

# 所有群對之間的質心距離
from itertools import combinations
dists = [np.linalg.norm(cent10[i] - cent10[j]) for i, j in combinations(range(10), 2)]
dists = np.sort(dists)
print('k=10 質心間距離：最小5個 =', np.round(dists[:5], 3), ' 中位數 =', round(np.median(dists), 3))

# 最小的那對是誰（應該就是 85/74 那對）
i, j = min(combinations(range(10), 2), key=lambda p: np.linalg.norm(cent10[p[0]] - cent10[p[1]]))
print(f'最相近兩群: 群{i}(n={np.sum(lab10==i)}) 與 群{j}(n={np.sum(lab10==j)}), 距離 = {np.linalg.norm(cent10[i]-cent10[j]):.3f}')
print('這兩群各欄質心差（標準化單位）:')
for f, a, b in zip(feat, cent10[i], cent10[j]):
    print(f'  {f:16s} {a:7.3f} vs {b:7.3f}  差 {a-b:+.3f}')

# 群內 RMS（每點到質心的距離 RMS）— 拆開後有沒有變「正常」
for c in range(10):
    m = lab10 == c
    rms = np.sqrt(((X[m] - cent10[c]) ** 2).sum(axis=1).mean())
    print(f'群 {c}: n={m.sum():3d}  內部RMS={rms:.3f}')
