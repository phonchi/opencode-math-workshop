→ Read figs/lab1_k_selection.png 
$ uv run python - <<'EOF'
import numpy as np
import pandas as pd
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score, silhouette_samples
from sklearn.preprocessing import StandardScaler

df = pd.read_csv('data/shops_daily.csv')
X = StandardScaler().fit_transform(df)

# k=9 解
lab9 = KMeans(9, random_state=0, n_init=10).fit_predict(X)
sizes = np.bincount(lab9)
big = sizes.argmax()
print('k=9 各群大小:', sizes.tolist())
print('最大群 label =', big, '大小 =', sizes[big])

# 每群平均 silhouette + 群內到質心的 RMS 距離
sil_samples = silhouette_samples(X, lab9)
for c in range(9):
    m = lab9 == c
    cent = X[m].mean(axis=0)
    rms = np.sqrt(((X[m] - cent) ** 2).sum(axis=1).mean())
    print(f'群 {c}: n={m.sum():3d}  內部RMS={rms:.3f}  平均silhouette={sil_samples[m].mean():.3f}')

# 把最大群抽出來，看它再拆 2 群的情形
sub = X[lab9 == big]
for k in (2, 3):
    s_lab = KMeans(k, random_state=0, n_init=10).fit_predict(sub)
    sil = silhouette_score(sub, s_lab)
    print(f'最大群內部再分 k={k}: silhouette={sil:.3f}, 大小={np.bincount(s_lab).tolist()}')

# k=10 對不同 random_state 的穩定性（大小分布）
for rs in range(5):
    lab10 = KMeans(10, random_state=rs, n_init=10).fit_predict(X)
    print(f'k=10, random_state={rs}: 大小={sorted(np.bincount(lab10).tolist())}')
