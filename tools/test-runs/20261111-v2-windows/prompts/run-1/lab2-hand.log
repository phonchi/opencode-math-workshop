資料確認乾淨（800 列 × 11 個數值欄、無 NaN）。先探一下手刻 eigh 和 sklearn 的實際數值差異量級，用來訂合理的門檻：
$ uv run python -c "
import numpy as np, pandas as pd
from sklearn.decomposition import PCA
X = pd.read_csv('data/orders.csv').to_numpy(float)
Xs = X / X.std(axis=0, ddof=0)
n = len(Xs)
Xc = Xs - Xs.mean(axis=0)
C = Xc.T @ Xc / (n - 1)
w, V = np.linalg.eigh(C)
idx = np.argsort(w)[::-1]
w, V = w[idx], V[:, idx]
k = 4
pca = PCA(n_components=k, svd_solver='full').fit(Xs)
print('eig diff      ', np.abs(w[:k] - pca.explained_variance_).max())
print('ratio diff    ', np.abs(w[:k]/w.sum() - pca.explained_variance_ratio_).max())
print('sval diff     ', np.abs(np.sqrt(w[:k]*(n-1)) - pca.singular_values_).max())
sgn = np.sign(np.sum(pca.components_.T * V[:, :k], axis=0))
Va = V[:, :k] * sgn
print('comp diff     ', np.abs(Va - pca.components_.T).max())
S = Xc @ Va
print('score diff    ', np.abs(S - pca.transform(Xs)).max())
print('score max mag ', np.abs(S).max())
print('VtV-I         ', np.abs(Va.T @ Va - np.eye(k)).max())
Sc = (S - S.mean(0)) / (n - 1) @ np.eye(k)
print('offdiag cov   ', np.abs(np.cov(S.T, ddof=1) - np.diag(w[:k])).max())
R = Xc - S @ Va.T
print('recon resid   ', np.abs(np.sum(R**2) - (n-1)*w[k:].sum()), (n-1)*w[k:].sum())
print('trace diff    ', np.abs(w.sum() - np.var(Xc, axis=0, ddof=1).sum()))
print('eigs          ', w[:k])
"
