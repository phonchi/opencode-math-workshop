9–10 附近確實是峰值（k 超過 12 之後三個指標一路變差，2–12 的範圍沒漏掉更好的 k）。還有一個重要線索：k=10 時有一對群中心只差 0.55，其他任兩群都至少差 1.69 —— k=10 是把某一群再切一半。我再確認那一大群（159 筆）切開後是「真的兩種店」還是「同一型的隨機切半」：
$ uv run python -c "
import numpy as np, pandas as pd
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler

df = pd.read_csv('data/shops_daily.csv')
cols = [c for c in df.columns if df[c].std() > 0]
X = StandardScaler().fit_transform(df[cols])

# k=9 下最大群（159 筆）內部再切 2，看兩半的樣子
km9 = KMeans(n_clusters=9, random_state=0, n_init=10).fit(X)
lab9 = km9.labels_
big = np.unique(lab9, return_counts=True)
big_id = big[0][np.argmax(big[1])]
idx = np.where(lab9 == big_id)[0]
print('最大群筆數：', len(idx))

sub = KMeans(n_clusters=2, random_state=0, n_init=10).fit(X[idx])
s_lab = sub.labels_
print('切成兩半筆數：', np.bincount(s_lab))

# 兩半在各欄位的平均差（標準化單位）
m0 = X[idx][s_lab==0].mean(axis=0)
m1 = X[idx][s_lab==1].mean(axis=0)
for c, a, b in zip(cols, m0, m1):
    print(f'{c:>15}: {a:+.2f} vs {b:+.2f}  (差 {a-b:+.2f} 個標準差)')
print('兩半中心距離：', round(np.linalg.norm(m0-m1),3))
print('其他群中心間距最小值(k=9)：1.77')

# 穩定性：不同 random_state 的 k=10 是否都切出同樣的一對近群
from itertools import combinations
for rs in [1, 7, 42]:
    km = KMeans(n_clusters=10, random_state=rs, n_init=10).fit(X)
    C = km.cluster_centers_
    d = min(np.linalg.norm(C[i]-C[j]) for i,j in combinations(range(10),2))
    print(f'random_state={rs}: 最近中心距離 = {d:.3f}, 最小群 = {np.bincount(km.labels_).min()}')
"
