結果出來了。在回答 A、B 之前，我先私下檢查一下資料結構（超出 2–12 的範圍、以及各群中心的分離度），確認 9/10 附近的訊號是真的結構而不是刚好落在邊界：
$ uv run python -c "
import numpy as np, pandas as pd
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score, calinski_harabasz_score, davies_bouldin_score
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA

df = pd.read_csv('data/shops_daily.csv')
X = StandardScaler().fit_transform(df.drop(columns=['open_hours','menu_version']))

# 檢查 k 超過 12 之後指標怎麼走（僅供判讀，不放进正式結果）
for k in range(9, 21):
    km = KMeans(n_clusters=k, random_state=0, n_init=10)
    lab = km.fit_predict(X)
    print(k, round(silhouette_score(X,lab),4), round(calinski_harabasz_score(X,lab),1), round(davies_bouldin_score(X,lab),3))

# k=10 各中心之間最近的距離（標準化空間）
km10 = KMeans(n_clusters=10, random_state=0, n_init=10).fit(X)
from itertools import combinations
C = km10.cluster_centers_
d = sorted(np.linalg.norm(C[i]-C[j]) for i,j in combinations(range(10),2))
print('k=10 最近中心距離：', [round(x,2) for x in d])
km9 = KMeans(n_clusters=9, random_state=0, n_init=10).fit(X)
C9 = km9.cluster_centers_
d9 = sorted(np.linalg.norm(C9[i]-C9[j]) for i,j in combinations(range(9),2))
print('k=9  最近中心距離：', [round(x,2) for x in d9])
p = PCA(2).fit(X).explained_variance_ratio_
print('PCA 前兩成分解釋變異：', p.round(3))
