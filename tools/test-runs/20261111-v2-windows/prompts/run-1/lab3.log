$ uv run python -c "
import pandas as pd, numpy as np
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
tr = pd.read_csv('data/loans.csv'); nw = pd.read_csv('data/loans_new_batch.csv')
feats = [c for c in tr.columns if c not in ('case_no','overdue')]
pipe = Pipeline([('s',StandardScaler()),('c',LogisticRegression(max_iter=1000))]).fit(tr[feats], tr['overdue'])
p = pipe.predict_proba(nw[feats])[:,1]
y = nw['overdue'].to_numpy()
ranks = pd.Series(p).rank(ascending=False, method='min').to_numpy().astype(int)
od = np.where(y==1)[0]
print('逾期案件 (機率, 名次):')
for i in sorted(od, key=lambda i:-p[i]): print(f'  p={p[i]:.4f}  rank={ranks[i]}')
print('前40名中逾期數:', int(y[np.argsort(-p)[:40]].sum()))
print('若寄45封可抓到:', int(y[np.argsort(-p)[:45]].sum()), ' 寄60封:', int(y[np.argsort(-p)[:60]].sum()))
print('第40名的機率:', np.sort(p)[::-1][39])
"
