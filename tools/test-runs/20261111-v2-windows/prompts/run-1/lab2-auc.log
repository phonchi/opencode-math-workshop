> build · big-pickle
AUC = 1.0000 這個結果太乾淨，我快速驗證一下不是流程洩漏造成的：
$ uv run python -c "
import pandas as pd, numpy as np
from sklearn.model_selection import StratifiedKFold
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import roc_auc_score

X = pd.read_csv('data/orders.csv'); y = pd.read_csv('data/orders_complaint.csv')['complaint']
cv = StratifiedKFold(5, shuffle=True, random_state=0)

# (a) 不用 PCA，直接標準化 + logistic：看是否本來就線性可分
p = Pipeline([('s', StandardScaler()), ('c', LogisticRegression(max_iter=1000))])
oof = np.zeros(len(y))
for tr, te in cv.split(X, y):
    p.fit(X.iloc[tr], y.iloc[tr]); oof[te] = p.predict_proba(X.iloc[te])[:,1]
print('無PCA AUC:', roc_auc_score(y, oof))

# (b) k=4 逐折 AUC
p4 = Pipeline([('s', StandardScaler()), ('p', PCA(4)), ('c', LogisticRegression(max_iter=1000))])
for i,(tr,te) in enumerate(cv.split(X,y)):
    p4.fit(X.iloc[tr], y.iloc[tr])
    print(f'fold{i} AUC:', roc_auc_score(y.iloc[te], p4.predict_proba(X.iloc[te])[:,1]))

# (c) 用第4主成分係數看訊號在哪
sc = StandardScaler().fit(X); Z = sc.transform(X)
pc = PCA(4).fit(Z)
print('PC 每折方向穩定性略。全資料PC4 loading:')
print(pd.Series(pc.components_[3], index=X.columns).sort_values().round(3).to_string())
print('PC4 與 label 相關:', np.corrcoef(Z @ pc.components_[3].T, y)[0,1])
"
