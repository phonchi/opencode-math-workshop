{"type":"tool_use","timestamp":1789229537943,"sessionID":"ses_f699c867bffen6Elxrdb7sKqi1","part":{"type":"tool","tool":"read","callID":"call_42370a0e884e4f50a0f16339","state":{"status":"completed","input":{"filePath":"/home/phonchi/opencode-math-workshop/tools/test-runs/20260912-workshop-refresh/wsl/project/lab1_cluster.py"},"output":"<path>/home/phonchi/opencode-math-workshop/tools/test-runs/20260912-workshop-refresh/wsl/project/lab1_cluster.py</path>\n<type>file</type>\n<content>\n1: import matplotlib.pyplot as plt\n2: from sklearn.cluster import KMeans\n3: from sklearn.datasets import load_digits\n4: from sklearn.metrics import silhouette_score\n5: \n6: digits = load_digits()\n7: X = digits.data\n8: \n9: k_range = range(2, 13)\n10: inertias = []\n11: silhouettes = []\n12: \n13: for k in k_range:\n14:     kmeans = KMeans(n_clusters=k, random_state=0, n_init=10)\n15:     labels = kmeans.fit_predict(X)\n16:     inertia = kmeans.inertia_\n17:     sil = silhouette_score(X, labels)\n18:     inertias.append(inertia)\n19:     silhouettes.append(sil)\n20:     print(f\"k={k:2d}  inertia={inertia:12.2f}  silhouette={sil:.4f}\")\n21: \n22: best_k = k_range[0]\n23: for k, sil in zip(k_range, silhouettes):\n24:     if sil > silhouettes[k_range.index(best_k)]:\n25:         best_k = k\n26: print(f\"\\n最高的 silhouette 出現在 k = {best_k}\")\n27: \n28: fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n29: axes[0].plot(list(k_range), inertias, marker=\"o\")\n30: axes[0].set_xlabel(\"k\")\n31: axes[0].set_ylabel(\"inertia\")\n32: axes[0].set_title(\"inertia vs k\")\n33: axes[1].plot(list(k_range), silhouettes, marker=\"o\")\n34: axes[1].axvline(best_k, color=\"r\", linestyle=\"--\", alpha=0.5)\n35: axes[1].set_xlabel(\"k\")\n36: axes[1].set_ylabel(\"silhouette score\")\n37: axes[1].set_title(\"silhouette vs k\")\n38: fig.tight_layout()\n39: fig.savefig(\"figs/lab1_k_selection.png\", dpi=150)\n\n(End of file - total 39 lines)\n</content>","metadata":{"preview":"import matplotlib.pyplot as plt\nfrom sklearn.cluster import KMeans\nfrom sklearn.datasets import load_digits\nfrom sklearn.metrics import silhouette_score\n\ndigits = load_digits()\nX = digits.data\n\nk_range = range(2, 13)\ninertias = []\nsilhouettes = []\n\nfor k in k_range:\n    kmeans = KMeans(n_clusters=k, random_state=0, n_init=10)\n    labels = kmeans.fit_predict(X)\n    inertia = kmeans.inertia_\n    sil = silhouette_score(X, labels)\n    inertias.append(inertia)\n    silhouettes.append(sil)\n    print(f\"k={k:2d}  inertia={inertia:12.2f}  silhouette={sil:.4f}\")","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/phonchi/opencode-math-workshop/tools/test-runs/20260912-workshop-refresh/wsl/project/lab1_cluster.py","text":"import matplotlib.pyplot as plt\nfrom sklearn.cluster import KMeans\nfrom sklearn.datasets import load_digits\nfrom sklearn.metrics import silhouette_score\n\ndigits = load_digits()\nX = digits.data\n\nk_range = range(2, 13)\ninertias = []\nsilhouettes = []\n\nfor k in k_range:\n    kmeans = KMeans(n_clusters=k, random_state=0, n_init=10)\n    labels = kmeans.fit_predict(X)\n    inertia = kmeans.inertia_\n    sil = silhouette_score(X, labels)\n    inertias.append(inertia)\n    silhouettes.append(sil)\n    print(f\"k={k:2d}  inertia={inertia:12.2f}  silhouette={sil:.4f}\")\n\nbest_k = k_range[0]\nfor k, sil in zip(k_range, silhouettes):\n    if sil > silhouettes[k_range.index(best_k)]:\n        best_k = k\nprint(f\"\\n最高的 silhouette 出現在 k = {best_k}\")\n\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\naxes[0].plot(list(k_range), inertias, marker=\"o\")\naxes[0].set_xlabel(\"k\")\naxes[0].set_ylabel(\"inertia\")\naxes[0].set_title(\"inertia vs k\")\naxes[1].plot(list(k_range), silhouettes, marker=\"o\")\naxes[1].axvline(best_k, color=\"r\", linestyle=\"--\", alpha=0.5)\naxes[1].set_xlabel(\"k\")\naxes[1].set_ylabel(\"silhouette score\")\naxes[1].set_title(\"silhouette vs k\")\nfig.tight_layout()\nfig.savefig(\"figs/lab1_k_selection.png\", dpi=150)","lineStart":1,"lineEnd":39,"totalLines":39,"truncated":false}},"title":"tools/test-runs/20260912-workshop-refresh/wsl/project/lab1_cluster.py","time":{"start":1789229537923,"end":1789229537941}},"id":"prt_09663d8ba001pyooMIngVI6pfa","sessionID":"ses_f699c867bffen6Elxrdb7sKqi1","messageID":"msg_09663c2db00183y3rIszj09Jcg"}}
{"type":"tool_use","timestamp":1789229538309,"sessionID":"ses_f699c867bffen6Elxrdb7sKqi1","part":{"type":"tool","tool":"read","callID":"call_631ef6d7ac4949c9ab5c8369","state":{"status":"completed","input":{"filePath":"/home/phonchi/opencode-math-workshop/tools/test-runs/20260912-workshop-refresh/wsl/project/lab3_logistic.py"},"output":"<path>/home/phonchi/opencode-math-workshop/tools/test-runs/20260912-workshop-refresh/wsl/project/lab3_logistic.py</path>\n<type>file</type>\n<content>\n1: \"\"\"二元 logistic 迴歸手刻（lab3）— 資料定義 + loss(w) + grad(w) + 有限差分梯度檢查。\n2: \n3: 損失函數衡量什麼：L(w) = (1/n) Σ [log(1+e^z) - y z] 是「平均負對數概似」，\n4: 衡量模型用權重 w 對資料預測得多準、多有把握——分數愈低，預測愈貼近真實標籤。\n5: 梯度告訴我們什麼：∇L(w) = (1/n) Xb^T (σ(Xb w) - y) 是損失在 w 處上升最快的方向，\n6: 各分量代表「把該權重調高一點，損失會增加多少」；負梯度是損失下降最快的方向。\n7: \n8: 推導（單樣本 z = x^T w，y ∈ {0,1}）：\n9: p(y|x) = σ(z)^y (1-σ(z))^(1-y)\n10: -log likelihood = y log σ(z) + (1-y) log(1-σ(z))\n11:                 = y[-log(1+e^{-z})] + (1-y)[-log(1+e^z)]\n12:                 = y[log(1+e^z) - z] + (1-y) log(1+e^z)\n13:                 = log(1+e^z) - y z\n14: ∂/∂w_j [-log p] = (σ(z) - y) x_j  →  ∇L = (1/n) Xb^T (σ(Xb w) - y)\n15: \"\"\"\n16: import numpy as np\n17: from sklearn.datasets import load_digits\n18: \n19: \n20: def sigmoid(z):\n21:     \"\"\"數值穩定的 sigmoid：z 很大用 1/(1+e^{-z})，z 很小用 e^z/(1+e^z)。\"\"\"\n22:     out = np.empty_like(z)\n23:     pos = z >= 0\n24:     out[pos] = 1.0 / (1.0 + np.exp(-z[pos]))\n25:     out[~pos] = np.exp(z[~pos]) / (1.0 + np.exp(z[~pos]))\n26:     return out\n27: \n28: \n29: def loss(w, Xb, y):\n30:     \"\"\"L(w) = (1/n) Σ [log(1+e^z) - y z]，z = Xb w，取平均。\"\"\"\n31:     z = Xb @ w\n32:     return np.mean(np.logaddexp(0.0, z) - y * z)\n33: \n34: \n35: def grad(w, Xb, y):\n36:     \"\"\"∇L(w) = (1/n) Xb^T (σ(Xb w) - y)。\"\"\"\n37:     z = Xb @ w\n38:     return (Xb.T @ (sigmoid(z) - y)) / len(y)\n39: \n40: \n41: def finite_diff_grad(f, w, h):\n42:     \"\"\"中央差分梯度：g_j = (f(w+h e_j) - f(w-h e_j)) / (2h)。\"\"\"\n43:     g = np.zeros_like(w)\n44:     for j in range(w.size):\n45:         e = np.zeros_like(w)\n46:         e[j] = 1.0\n47:         g[j] = (f(w + h * e) - f(w - h * e)) / (2.0 * h)\n48:     return g\n49: \n50: \n51: # ---------- 資料定義：全部 digits 的 3 與 8 ----------\n52: digits = load_digits()\n53: mask = (digits.target == 3) | (digits.target == 8)\n54: Xpix = digits.data[mask] / 16.0                      # 像素除以 16\n55: y = (digits.target[mask] == 8).astype(float)         # 8 設為 1、3 設為 0\n56: Xb = np.hstack([np.ones((Xpix.shape[0], 1)), Xpix])  # 加一欄 1 當截距\n57: n, d = Xb.shape\n58: print(f\"Xb shape = {Xb.shape}  (n={n}, d={d})\")\n59: \n60: \n61: # ---------- 有限差分梯度檢查（中央差分，全部 65 維） ----------\n62: w0 = np.random.RandomState(0).normal(size=d) * 0.01\n63: print(f\"檢查點 w0 = {np.array2string(w0, precision=6)}\")\n64: \n65: g_anal = grad(w0, Xb, y)\n66: print(\"\\n      h       max|Δg|      max rel err   判定\")\n67: for h in np.logspace(-2, -9, 8):\n68:     g_num = finite_diff_grad(lambda w: loss(w, Xb, y), w0, h)\n69:     abs_err = np.max(np.abs(g_num - g_anal))\n70:     rel_err = np.max(np.abs(g_num - g_anal) / np.maximum(np.abs(g_anal), 1e-12))\n71:     verdict = \"PASS\" if abs_err < 1e-8 else \"需調查\"\n72:     print(f\"{h:9.1e}  {abs_err:12.3e}  {rel_err:12.3e}  {verdict}\")\n\n(End of file - total 72 lines)\n</content>","metadata":{"preview":"\"\"\"二元 logistic 迴歸手刻（lab3）— 資料定義 + loss(w) + grad(w) + 有限差分梯度檢查。\n\n損失函數衡量什麼：L(w) = (1/n) Σ [log(1+e^z) - y z] 是「平均負對數概似」，\n衡量模型用權重 w 對資料預測得多準、多有把握——分數愈低，預測愈貼近真實標籤。\n梯度告訴我們什麼：∇L(w) = (1/n) Xb^T (σ(Xb w) - y) 是損失在 w 處上升最快的方向，\n各分量代表「把該權重調高一點，損失會增加多少」；負梯度是損失下降最快的方向。\n\n推導（單樣本 z = x^T w，y ∈ {0,1}）：\np(y|x) = σ(z)^y (1-σ(z))^(1-y)\n-log likelihood = y log σ(z) + (1-y) log(1-σ(z))\n                = y[-log(1+e^{-z})] + (1-y)[-log(1+e^z)]\n                = y[log(1+e^z) - z] + (1-y) log(1+e^z)\n                = log(1+e^z) - y z\n∂/∂w_j [-log p] = (σ(z) - y) x_j  →  ∇L = (1/n) Xb^T (σ(Xb w) - y)\n\"\"\"\nimport numpy as np\nfrom sklearn.datasets import load_digits\n\n\ndef sigmoid(z):","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/phonchi/opencode-math-workshop/tools/test-runs/20260912-workshop-refresh/wsl/project/lab3_logistic.py","text":"\"\"\"二元 logistic 迴歸手刻（lab3）— 資料定義 + loss(w) + grad(w) + 有限差分梯度檢查。\n\n損失函數衡量什麼：L(w) = (1/n) Σ [log(1+e^z) - y z] 是「平均負對數概似」，\n衡量模型用權重 w 對資料預測得多準、多有把握——分數愈低，預測愈貼近真實標籤。\n梯度告訴我們什麼：∇L(w) = (1/n) Xb^T (σ(Xb w) - y) 是損失在 w 處上升最快的方向，\n各分量代表「把該權重調高一點，損失會增加多少」；負梯度是損失下降最快的方向。\n\n推導（單樣本 z = x^T w，y ∈ {0,1}）：\np(y|x) = σ(z)^y (1-σ(z))^(1-y)\n-log likelihood = y log σ(z) + (1-y) log(1-σ(z))\n                = y[-log(1+e^{-z})] + (1-y)[-log(1+e^z)]\n                = y[log(1+e^z) - z] + (1-y) log(1+e^z)\n                = log(1+e^z) - y z\n∂/∂w_j [-log p] = (σ(z) - y) x_j  →  ∇L = (1/n) Xb^T (σ(Xb w) - y)\n\"\"\"\nimport numpy as np\nfrom sklearn.datasets import load_digits\n\n\ndef sigmoid(z):\n    \"\"\"數值穩定的 sigmoid：z 很大用 1/(1+e^{-z})，z 很小用 e^z/(1+e^z)。\"\"\"\n    out = np.empty_like(z)\n    pos = z >= 0\n    out[pos] = 1.0 / (1.0 + np.exp(-z[pos]))\n    out[~pos] = np.exp(z[~pos]) / (1.0 + np.exp(z[~pos]))\n    return out\n\n\ndef loss(w, Xb, y):\n    \"\"\"L(w) = (1/n) Σ [log(1+e^z) - y z]，z = Xb w，取平均。\"\"\"\n    z = Xb @ w\n    return np.mean(np.logaddexp(0.0, z) - y * z)\n\n\ndef grad(w, Xb, y):\n    \"\"\"∇L(w) = (1/n) Xb^T (σ(Xb w) - y)。\"\"\"\n    z = Xb @ w\n    return (Xb.T @ (sigmoid(z) - y)) / len(y)\n\n\ndef finite_diff_grad(f, w, h):\n    \"\"\"中央差分梯度：g_j = (f(w+h e_j) - f(w-h e_j)) / (2h)。\"\"\"\n    g = np.zeros_like(w)\n    for j in range(w.size):\n        e = np.zeros_like(w)\n        e[j] = 1.0\n        g[j] = (f(w + h * e) - f(w - h * e)) / (2.0 * h)\n    return g\n\n\n# ---------- 資料定義：全部 digits 的 3 與 8 ----------\ndigits = load_digits()\nmask = (digits.target == 3) | (digits.target == 8)\nXpix = digits.data[mask] / 16.0                      # 像素除以 16\ny = (digits.target[mask] == 8).astype(float)         # 8 設為 1、3 設為 0\nXb = np.hstack([np.ones((Xpix.shape[0], 1)), Xpix])  # 加一欄 1 當截距\nn, d = Xb.shape\nprint(f\"Xb shape = {Xb.shape}  (n={n}, d={d})\")\n\n\n# ---------- 有限差分梯度檢查（中央差分，全部 65 維） ----------\nw0 = np.random.RandomState(0).normal(size=d) * 0.01\nprint(f\"檢查點 w0 = {np.array2string(w0, precision=6)}\")\n\ng_anal = grad(w0, Xb, y)\nprint(\"\\n      h       max|Δg|      max rel err   判定\")\nfor h in np.logspace(-2, -9, 8):\n    g_num = finite_diff_grad(lambda w: loss(w, Xb, y), w0, h)\n    abs_err = np.max(np.abs(g_num - g_anal))\n    rel_err = np.max(np.abs(g_num - g_anal) / np.maximum(np.abs(g_anal), 1e-12))\n    verdict = \"PASS\" if abs_err < 1e-8 else \"需調查\"\n    print(f\"{h:9.1e}  {abs_err:12.3e}  {rel_err:12.3e}  {verdict}\")","lineStart":1,"lineEnd":72,"totalLines":72,"truncated":false}},"title":"tools/test-runs/20260912-workshop-refresh/wsl/project/lab3_logistic.py","time":{"start":1789229538296,"end":1789229538308}},"id":"prt_096641b2e001X6j4Qjl9ZwQg9S","sessionID":"ses_f699c867bffen6Elxrdb7sKqi1","messageID":"msg_09663c2db00183y3rIszj09Jcg"}}
