{"type":"tool_use","timestamp":1789229509075,"sessionID":"ses_f699c867bffen6Elxrdb7sKqi1","part":{"type":"tool","tool":"read","callID":"call_180a3e4c270541b3abf57783","state":{"status":"completed","input":{"filePath":"/home/phonchi/opencode-math-workshop/tools/test-runs/20260912-workshop-refresh/wsl/project/figs"},"output":"<path>/home/phonchi/opencode-math-workshop/tools/test-runs/20260912-workshop-refresh/wsl/project/figs</path>\n<type>directory</type>\n<entries>\nlab1_k_selection.png\n\n(1 entries)\n</entries>","metadata":{"preview":"lab1_k_selection.png","truncated":false,"loaded":[],"display":{"type":"directory","path":"/home/phonchi/opencode-math-workshop/tools/test-runs/20260912-workshop-refresh/wsl/project/figs","entries":["lab1_k_selection.png"],"offset":1,"totalEntries":1,"truncated":false}},"title":"tools/test-runs/20260912-workshop-refresh/wsl/project/figs","time":{"start":1789229509071,"end":1789229509074}},"id":"prt_09663a8ea001pLfVWOKiXcKwqH","sessionID":"ses_f699c867bffen6Elxrdb7sKqi1","messageID":"msg_096639e72001H6CLPKj1zKCnHY"}}
{"type":"tool_use","timestamp":1789229509829,"sessionID":"ses_f699c867bffen6Elxrdb7sKqi1","part":{"type":"tool","tool":"read","callID":"call_67f0ea2a56eb41348fff7648","state":{"status":"completed","input":{"filePath":"/home/phonchi/opencode-math-workshop/tools/test-runs/20260912-workshop-refresh/wsl/project/lab2_pca.py"},"output":"<path>/home/phonchi/opencode-math-workshop/tools/test-runs/20260912-workshop-refresh/wsl/project/lab2_pca.py</path>\n<type>file</type>\n<content>\n1: import numpy as np\n2: from sklearn.datasets import load_digits\n3: from sklearn.decomposition import PCA\n4: \n5: N_COMPONENTS = 10\n6: \n7: digits = load_digits()\n8: X = digits.data\n9: n_samples, n_features = X.shape\n10: \n11: \n12: def my_pca_topk(X, k):\n13:     \"\"\"手刻 PCA：只許用 numpy。中心化 -> 共變異數矩陣 -> eigh -> 排序 -> 取前 k。\"\"\"\n14:     X_centered = X - X.mean(axis=0)\n15:     cov = (X_centered.T @ X_centered) / (n_samples - 1)\n16:     eigvals, eigvecs = np.linalg.eigh(cov)\n17: \n18:     order = np.argsort(eigvals)[::-1]\n19:     top = order[:k]\n20:     components = eigvecs[:, top].T\n21:     explained_variance = eigvals[top]\n22: \n23:     # 對齊 sklearn 的 sign convention（svd_flip, u_based_decision=False）：\n24:     # 每個主成分在\"絕對值最大\"那一格必須為正。\n25:     max_idx = np.argmax(np.abs(components), axis=1)\n26:     signs = np.sign(components[np.arange(k), max_idx])\n27:     components = components * signs[:, None]\n28: \n29:     return components, explained_variance\n30: \n31: \n32: components_hand, var_hand = my_pca_topk(X, N_COMPONENTS)\n33: \n34: ref = PCA(n_components=N_COMPONENTS, svd_solver=\"full\", random_state=0)\n35: ref.fit(X)\n36: \n37: components_sk, var_sk = ref.components_, ref.explained_variance_\n38: \n39: print(f\"資料形狀: X{n_features} 維 x {n_samples} 個樣本\\n\")\n40: \n41: # 1. 特徵值本身（explained_variance_）\n42: print(\"=== 1. 特徵值 (explained_variance_) 比對 ===\")\n43: for i in range(N_COMPONENTS):\n44:     print(f\"  PC{i+1:2d}  手刻={var_hand[i]:12.6f}   sklearn={var_sk[i]:12.6f}\")\n45: max_diff_var = np.max(np.abs(var_hand - var_sk))\n46: print(f\"  最大絕對差 = {max_diff_var:.6e}  ->  {max_diff_var < 1e-10}\")\n47: \n48: # 2. 解釋變異比例\n49: print(\"\\n=== 2. 解釋變異比例 (explained_variance_ratio_) 比對 ===\")\n50: ratio_hand = var_hand / var_hand.sum()\n51: ratio_sk = var_sk / var_sk.sum()\n52: for i in range(N_COMPONENTS):\n53:     print(f\"  PC{i+1:2d}  手刻={ratio_hand[i]:.8f}   sklearn={ratio_sk[i]:.8f}\")\n54: print(f\"  累計比例(前10) = {ratio_hand.sum():.6f}\")\n55: max_diff_ratio = np.max(np.abs(ratio_hand - ratio_sk))\n56: print(f\"  最大絕對差 = {max_diff_ratio:.6e}  ->  {max_diff_ratio < 1e-10}\")\n57: \n58: # 3. 方向與正負號\n59: print(\"\\n=== 3. 方向與正負號 比對 ===\")\n60: align = np.sum(np.sign(components_hand) * np.sign(components_sk), axis=1)\n61: dot = np.abs(np.sum(components_hand * components_sk, axis=1))\n62: idx = np.argmax(np.abs(components_sk), axis=1)\n63: for i in range(N_COMPONENTS):\n64:     ag = \"同向\" if align[i] > 0 else \"反向\"\n65:     print(f\"  PC{i+1:2d}  |內積|={dot[i]:.8f}  正負號對齊={ag}  max|位置|符號(手刻/sklearn)={np.sign(components_hand[i,idx[i]]):+.0f}/{np.sign(components_sk[i,idx[i]]):+.0f}\")\n66: max_dot_err = np.max(1 - dot)\n67: print(f\"  最大(1-|內積|) = {max_dot_err:.6e}  ->  {max_dot_err < 1e-8}\")\n68: \n69: # 4. 正交性：手刻的主成分彼此正交\n70: print(\"\\n=== 4. 手刻主成分正交性 ===\")\n71: gram = components_hand @ components_hand.T\n72: print(f\"  Gram matrix 第 1 列 = {np.round(gram[0], 4)}\")\n73: off = np.abs(gram - np.eye(N_COMPONENTS))\n74: print(f\"  最大非對角元素(|C C^T - I|) = {np.max(off):.6e}  ->  {np.max(off) < 1e-10}\")\n75: \n76: # 5. 重建誤差\n77: print(\"\\n=== 5. 重建誤差 比對 ===\")\n78: Xc = X - X.mean(axis=0)\n79: recon_hand = Xc @ components_hand.T @ components_hand + X.mean(axis=0)\n80: recon_sk = ref.inverse_transform(ref.transform(X))\n81: err_hand = np.linalg.norm(X - recon_hand)\n82: err_sk = np.linalg.norm(X - recon_sk)\n83: diff_er = np.linalg.norm(recon_hand - recon_sk)\n84: print(f\"  手刻重建誤差 ||X - X_hat||  = {err_hand:.8f}\")\n85: print(f\"  sklearn 重建誤差 ||X - X_hat|| = {err_sk:.8f}\")\n86: print(f\"  兩者重建結果差 ||Xhat_hand - Xhat_sk|| = {diff_er:.6e}  ->  {diff_er < 1e-8}\")\n\n(End of file - total 86 lines)\n</content>","metadata":{"preview":"import numpy as np\nfrom sklearn.datasets import load_digits\nfrom sklearn.decomposition import PCA\n\nN_COMPONENTS = 10\n\ndigits = load_digits()\nX = digits.data\nn_samples, n_features = X.shape\n\n\ndef my_pca_topk(X, k):\n    \"\"\"手刻 PCA：只許用 numpy。中心化 -> 共變異數矩陣 -> eigh -> 排序 -> 取前 k。\"\"\"\n    X_centered = X - X.mean(axis=0)\n    cov = (X_centered.T @ X_centered) / (n_samples - 1)\n    eigvals, eigvecs = np.linalg.eigh(cov)\n\n    order = np.argsort(eigvals)[::-1]\n    top = order[:k]\n    components = eigvecs[:, top].T","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/phonchi/opencode-math-workshop/tools/test-runs/20260912-workshop-refresh/wsl/project/lab2_pca.py","text":"import numpy as np\nfrom sklearn.datasets import load_digits\nfrom sklearn.decomposition import PCA\n\nN_COMPONENTS = 10\n\ndigits = load_digits()\nX = digits.data\nn_samples, n_features = X.shape\n\n\ndef my_pca_topk(X, k):\n    \"\"\"手刻 PCA：只許用 numpy。中心化 -> 共變異數矩陣 -> eigh -> 排序 -> 取前 k。\"\"\"\n    X_centered = X - X.mean(axis=0)\n    cov = (X_centered.T @ X_centered) / (n_samples - 1)\n    eigvals, eigvecs = np.linalg.eigh(cov)\n\n    order = np.argsort(eigvals)[::-1]\n    top = order[:k]\n    components = eigvecs[:, top].T\n    explained_variance = eigvals[top]\n\n    # 對齊 sklearn 的 sign convention（svd_flip, u_based_decision=False）：\n    # 每個主成分在\"絕對值最大\"那一格必須為正。\n    max_idx = np.argmax(np.abs(components), axis=1)\n    signs = np.sign(components[np.arange(k), max_idx])\n    components = components * signs[:, None]\n\n    return components, explained_variance\n\n\ncomponents_hand, var_hand = my_pca_topk(X, N_COMPONENTS)\n\nref = PCA(n_components=N_COMPONENTS, svd_solver=\"full\", random_state=0)\nref.fit(X)\n\ncomponents_sk, var_sk = ref.components_, ref.explained_variance_\n\nprint(f\"資料形狀: X{n_features} 維 x {n_samples} 個樣本\\n\")\n\n# 1. 特徵值本身（explained_variance_）\nprint(\"=== 1. 特徵值 (explained_variance_) 比對 ===\")\nfor i in range(N_COMPONENTS):\n    print(f\"  PC{i+1:2d}  手刻={var_hand[i]:12.6f}   sklearn={var_sk[i]:12.6f}\")\nmax_diff_var = np.max(np.abs(var_hand - var_sk))\nprint(f\"  最大絕對差 = {max_diff_var:.6e}  ->  {max_diff_var < 1e-10}\")\n\n# 2. 解釋變異比例\nprint(\"\\n=== 2. 解釋變異比例 (explained_variance_ratio_) 比對 ===\")\nratio_hand = var_hand / var_hand.sum()\nratio_sk = var_sk / var_sk.sum()\nfor i in range(N_COMPONENTS):\n    print(f\"  PC{i+1:2d}  手刻={ratio_hand[i]:.8f}   sklearn={ratio_sk[i]:.8f}\")\nprint(f\"  累計比例(前10) = {ratio_hand.sum():.6f}\")\nmax_diff_ratio = np.max(np.abs(ratio_hand - ratio_sk))\nprint(f\"  最大絕對差 = {max_diff_ratio:.6e}  ->  {max_diff_ratio < 1e-10}\")\n\n# 3. 方向與正負號\nprint(\"\\n=== 3. 方向與正負號 比對 ===\")\nalign = np.sum(np.sign(components_hand) * np.sign(components_sk), axis=1)\ndot = np.abs(np.sum(components_hand * components_sk, axis=1))\nidx = np.argmax(np.abs(components_sk), axis=1)\nfor i in range(N_COMPONENTS):\n    ag = \"同向\" if align[i] > 0 else \"反向\"\n    print(f\"  PC{i+1:2d}  |內積|={dot[i]:.8f}  正負號對齊={ag}  max|位置|符號(手刻/sklearn)={np.sign(components_hand[i,idx[i]]):+.0f}/{np.sign(components_sk[i,idx[i]]):+.0f}\")\nmax_dot_err = np.max(1 - dot)\nprint(f\"  最大(1-|內積|) = {max_dot_err:.6e}  ->  {max_dot_err < 1e-8}\")\n\n# 4. 正交性：手刻的主成分彼此正交\nprint(\"\\n=== 4. 手刻主成分正交性 ===\")\ngram = components_hand @ components_hand.T\nprint(f\"  Gram matrix 第 1 列 = {np.round(gram[0], 4)}\")\noff = np.abs(gram - np.eye(N_COMPONENTS))\nprint(f\"  最大非對角元素(|C C^T - I|) = {np.max(off):.6e}  ->  {np.max(off) < 1e-10}\")\n\n# 5. 重建誤差\nprint(\"\\n=== 5. 重建誤差 比對 ===\")\nXc = X - X.mean(axis=0)\nrecon_hand = Xc @ components_hand.T @ components_hand + X.mean(axis=0)\nrecon_sk = ref.inverse_transform(ref.transform(X))\nerr_hand = np.linalg.norm(X - recon_hand)\nerr_sk = np.linalg.norm(X - recon_sk)\ndiff_er = np.linalg.norm(recon_hand - recon_sk)\nprint(f\"  手刻重建誤差 ||X - X_hat||  = {err_hand:.8f}\")\nprint(f\"  sklearn 重建誤差 ||X - X_hat|| = {err_sk:.8f}\")\nprint(f\"  兩者重建結果差 ||Xhat_hand - Xhat_sk|| = {diff_er:.6e}  ->  {diff_er < 1e-8}\")","lineStart":1,"lineEnd":86,"totalLines":86,"truncated":false}},"title":"tools/test-runs/20260912-workshop-refresh/wsl/project/lab2_pca.py","time":{"start":1789229509819,"end":1789229509827}},"id":"prt_09663aa0f0018aXbdXFM55fciQ","sessionID":"ses_f699c867bffen6Elxrdb7sKqi1","messageID":"msg_096639e72001H6CLPKj1zKCnHY"}}
