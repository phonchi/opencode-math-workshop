loss(w_gd)=%.8f loss(w_sk)=%.8f'%(L.loss(wg,X1,ytr),L.loss(ws,X1,ytr))); print('loss(w_sk) - loss(w_gd) = %.3e'%(L.loss(ws,X1,ytr)-L.loss(wg,X1,ytr))); print('grad norm at w_sk = %.3e'%np.linalg.norm(L.grad(ws,X1,ytr)))\"","time":{"start":1789228128255,"end":1789228131723}},"id":"prt_0964e87bc001QS5K8azGelsxmH","sessionID":"ses_f69b53dfaffe6jVh3DZezfRAcf","messageID":"msg_0964e2f17001t4ELhcQAPcRzCj"}}
