+print(\"checkpoint w0 = np.random.RandomState(0).normal(size=65) * 0.01\")\n print()\n print(f\"{'h':>8}  {'max |fd - analytic|':>20}  {'max |rel err|':>14}\")\n print(\"-\" * 52)\n for p in range(2, 10):\n","additions":1,"deletions":1},"truncated":false},"title":"Users\\User\\Documents\\ai-math-refresh-20260912\\agent-lab3-notes-auto\\lab3_logistic.py","time":{"start":1789228452954,"end":1789228452962}},"id":"prt_096538a100019hrbHQZtgkXZ7t","sessionID":"ses_f69b53dfaffe6jVh3DZezfRAcf","messageID":"msg_0965382a1001xfBAgY382H4Lpp"}}
