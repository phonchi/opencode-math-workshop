.max()\n52:     ratio_diff = np.abs(mine[\"explained_variance_ratio\"] - pca.explained_variance_ratio_).max()\n53: \n54:     aligned_axes, signs = align_axes(mine[\"axes\"], pca.components_.T)\n55:     colinearity = np.abs((aligned_axes * pca.components_.T).sum(axis=0))\n56:     axes_diff = np.abs(aligned_axes - pca.components_.T).max()\n57: \n58:     Pc = ((aligned_axes * pca.components_.T).sum(axis=0) /\n59:           (np.linalg.norm(aligned_axes, axis=0) * np.linalg.norm(pca.components_.T, axis=0)))\n60:     angles = np.degrees(np.arccos(np.clip(Pc, -1.0, 1.0)))\n61: \n62:     scores_aligned = mine[\"scores\"] @ np.diag(signs)\n63:     scores_diff = np.abs(scores_aligned - scores_ref).max()\n64: \n65:     X_ref_hat = pca.inverse_transform(scores_ref)\n66:     X_hat = scores_aligned @ aligned_axes.T + mine[\"mean\"]\n67:     recon_diff = np.abs(X_ref_hat - X_hat).max()\n68: \n69:     print(f\"資料集: sklearn digits, X 形狀 = {X.shape} (n={X.shape[0]}, d={X.shape[1]})\")\n70:     print(f\"取前 {N_COMPONENTS} 個主成分，效能公差 = {TOL:.0e}\\n\")\n71: \n72:     print(\"== 驗證 1: explained_variance（手刻特徵值 vs sklearn 奇異值平方/(n-1)）==\")\n73:     for i in range(N_COMPONENTS):\n74:         ev_ref = pca.explained_variance_[i]\n75:         ev_mine = mine[\"explained_variance\"][i]\n76:         print(f\"  PC{i + 1:>2}: 手刻={ev_mine:.12f}  sklearn={ev_ref:.12f}  \"\n77:               f\"diff={abs(ev_mine - ev_ref):.3e}\")\n78:     print(f\"  max|diff| = {evar_diff:.3e} -> {'PASS' if evar_diff < TOL else 'FAIL'}\\n\")\n79: \n80:     print(\"== 驗證 2: explained_variance_ratio（手刻 λi/Σλ vs sklearn）==\")\n81:     for i in range(N_COMPONENTS):\n82:         r_mine = mine[\"explained_variance_ratio\"][i]\n83:         r_ref = pca.explained_variance_ratio_[i]\n84:         print(f\"  PC{i + 1:>2}: 手刻={r_mine:.10f}  sklearn={r_ref:.10f}  \"\n85:               f\"diff={abs(r_mine - r_ref):.3e}\")\n86:     print(f\"  手刻 ratio 總和={mine['explained_variance_ratio'].sum():.10f}  \"\n87:           f\"sklearn ratio 總和={pca.explained_variance_ratio_.sum():.10f}\")\n88:     print(f\"  max|diff| = {ratio_diff:.3e} -> {'PASS' if ratio_diff < TOL else 'FAIL'}\\n\")\n89: \n90:     print(\"== 驗證 3: 載入向量（符號對齊後）==\")\n91:     for i in range(N_COMPONENTS):\n92:         print(f\"  PC{i + 1:>2}: 手刻符號={signs[i]:+.0f}, 對齊後夾角={angles[i]:.6f} deg, \"\n93:               f\"|內積|={colinearity[i]:.12f}\")\n94:     print(f\"  max|diff|(對齊後矩陣) = {axes_diff:.3e} -> {'PASS' if axes_diff < TOL else 'FAIL'}\\n\")\n95: \n96:     print(\"== 驗證 4: 主成分得分（符號對齊後）==\")\n97:     print(\"  前 5 列 in PC1..PC3: 手刻 vs sklearn\")\n98:     for i in range(5):\n99:         print(f\"    row{i}: 手刻={scores_aligned[i, :3]}  ref={scores_ref[i, :3]}\")\n100:     print(f\"  max|diff|(全部 {X.shape[0]}x{N_COMPONENTS}) = {scores_diff:.3e} \"\n101:           f\"-> {'PASS' if scores_diff < TOL else 'FAIL'}\\n\")\n102: \n103:     print(\"== 驗證 5: 重建 X ≈ pca.inverse_transform(得分) ==\")\n104:     print(f\"  手刻重建 vs sklearn 重建 max|diff| = {recon_diff:.3e} \"\n105:           f\"-> {'PASS' if recon_diff < TOL else 'FAIL'}\")\n106: \n107:     all_pass = (evar_diff < TOL and ratio_diff < TOL and axes_diff < TOL and\n108:                 scores_diff < TOL and recon_diff < TOL)\n109:     print(\"\\n總結:\", \"全部 PASS：手刻 PCA 與 sklearn PCA 一致\" if all_pass else \"部分 FAIL\")\n110: \n111: \n112: if __name__ == \"__main__\":\n113:     verify()\n\n(End of file - total 113 lines)\n</content>","metadata":{"preview":"import numpy as np\nfrom sklearn.datasets import load_digits\nfrom sklearn.decomposition import PCA\n\nN_COMPONENTS = 10\nTOL = 1e-9\n\n\ndef hand_pca(X, n_components=N_COMPONENTS):\n    n_samples, _ = X.shape\n    mu = X.mean(axis=0)\n    Xc = X - mu\n    cov = (Xc.T @ Xc) / (n_samples - 1)\n    eigvals, eigvecs = np.linalg.eigh(cov)\n    order = np.argsort(eigvals)[::-1]\n    eigvals_sorted = eigvals[order]\n    axes = eigvecs[:, order][:, :n_components]\n    scores = Xc @ axes\n    evar = eigvals_sorted[:n_components]\n    return {","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\Users\\User\\Documents\\ai-math-refresh-20260912\\agent-workflow-auto\\lab2_pca.py","text":"import numpy as np\nfrom sklearn.datasets import load_digits\nfrom sklearn.decomposition import PCA\n\nN_COMPONENTS = 10\nTOL = 1e-9\n\n\ndef hand_pca(X, n_components=N_COMPONENTS):\n    n_samples, _ = X.shape\n    mu = X.mean(axis=0)\n    Xc = X - mu\n    cov = (Xc.T @ Xc) / (n_samples - 1)\n    eigvals, eigvecs = np.linalg.eigh(cov)\n    order = np.argsort(eigvals)[::-1]\n    eigvals_sorted = eigvals[order]\n    axes = eigvecs[:, order][:, :n_components]\n    scores = Xc @ axes\n    evar = eigvals_sorted[:n_components]\n    return {\n        \"mean\": mu,\n        \"axes\": axes,\n        \"scores\": scores,\n        \"explained_variance\": evar,\n        \"explained_variance_ratio\": evar / eigvals_sorted.sum(),\n    }\n\n\ndef align_axes(W, W_ref):\n    aligned = np.empty_like(W)\n    signs = np.empty(W.shape[1])\n    for i in range(W.shape[1]):\n        s = np.sign(W[:, i] @ W_ref[:, i])\n        if s == 0.0:\n            s = 1.0\n        aligned[:, i] = W[:, i] * s\n        signs[i] = s\n    return aligned, signs\n\n\ndef verify():\n    X, y = load_digits(return_X_y=True)\n    np.random.seed(0)\n\n    mine = hand_pca(X)\n\n    pca = PCA(n_components=N_COMPONENTS, svd_solver=\"full\", random_state=0)\n    pca.fit(X)\n    scores_ref = pca.transform(X)\n\n    evar_diff = np.abs(mine[\"explained_variance\"] - pca.explained_variance_).max()\n    ratio_diff = np.abs(mine[\"explained_variance_ratio\"] - pca.explained_variance_ratio_).max()\n\n    aligned_axes, signs = align_axes(mine[\"axes\"], pca.components_.T)\n    colinearity = np.abs((aligned_axes * pca.components_.T).sum(axis=0))\n    axes_diff = np.abs(aligned_axes - pca.components_.T).max()\n\n    Pc = ((aligned_axes * pca.components_.T).sum(axis=0) /\n          (np.linalg.norm(aligned_axes, axis=0) * np.linalg.norm(pca.components_.T, axis=0)))\n    angles = np.degrees(np.arccos(np.clip(Pc, -1.0, 1.0)))\n\n    scores_aligned = mine[\"scores\"] @ np.diag(signs)\n    scores_diff = np.abs(scores_aligned - scores_ref).max()\n\n    X_ref_hat = pca.inverse_transform(scores_ref)\n    X_hat = scores_aligned @ aligned_axes.T + mine[\"mean\"]\n    recon_diff = np.abs(X_ref_hat - X_hat).max()\n\n    print(f\"資料集: sklearn digits, X 形狀 = {X.shape} (n={X.shape[0]}, d={X.shape[1]})\")\n    print(f\"取前 {N_COMPONENTS} 個主成分，效能公差 = {TOL:.0e}\\n\")\n\n    print(\"== 驗證 1: explained_variance（手刻特徵值 vs sklearn 奇異值平方/(n-1)）==\")\n    for i in range(N_COMPONENTS):\n        ev_ref = pca.explained_variance_[i]\n        ev_mine = mine[\"explained_variance\"][i]\n        print(f\"  PC{i + 1:>2}: 手刻={ev_mine:.12f}  sklearn={ev_ref:.12f}  \"\n              f\"diff={abs(ev_mine - ev_ref):.3e}\")\n    print(f\"  max|diff| = {evar_diff:.3e} -> {'PASS' if evar_diff < TOL else 'FAIL'}\\n\")\n\n    print(\"== 驗證 2: explained_variance_ratio（手刻 λi/Σλ vs sklearn）==\")\n    for i in range(N_COMPONENTS):\n        r_mine = mine[\"explained_variance_ratio\"][i]\n        r_ref = pca.explained_variance_ratio_[i]\n        print(f\"  PC{i + 1:>2}: 手刻={r_mine:.10f}  sklearn={r_ref:.10f}  \"\n              f\"diff={abs(r_mine - r_ref):.3e}\")\n    print(f\"  手刻 ratio 總和={mine['explained_variance_ratio'].sum():.10f}  \"\n          f\"sklearn ratio 總和={pca.explained_variance_ratio_.sum():.10f}\")\n    print(f\"  max|diff| = {ratio_diff:.3e} -> {'PASS' if ratio_diff < TOL else 'FAIL'}\\n\")\n\n    print(\"== 驗證 3: 載入向量（符號對齊後）==\")\n    for i in range(N_COMPONENTS):\n        print(f\"  PC{i + 1:>2}: 手刻符號={signs[i]:+.0f}, 對齊後夾角={angles[i]:.6f} deg, \"\n              f\"|內積|={colinearity[i]:.12f}\")\n    print(f\"  max|diff|(對齊後矩陣) = {axes_diff:.3e} -> {'PASS' if axes_diff < TOL else 'FAIL'}\\n\")\n\n    print(\"== 驗證 4: 主成分得分（符號對齊後）==\")\n    print(\"  前 5 列 in PC1..PC3: 手刻 vs sklearn\")\n    for i in range(5):\n        print(f\"    row{i}: 手刻={scores_aligned[i, :3]}  ref={scores_ref[i, :3]}\")\n    print(f\"  max|diff|(全部 {X.shape[0]}x{N_COMPONENTS}) = {scores_diff:.3e} \"\n          f\"-> {'PASS' if scores_diff < TOL else 'FAIL'}\\n\")\n\n    print(\"== 驗證 5: 重建 X ≈ pca.inverse_transform(得分) ==\")\n    print(f\"  手刻重建 vs sklearn 重建 max|diff| = {recon_diff:.3e} \"\n          f\"-> {'PASS' if recon_diff < TOL else 'FAIL'}\")\n\n    all_pass = (evar_diff < TOL and ratio_diff < TOL and axes_diff < TOL and\n                scores_diff < TOL and recon_diff < TOL)\n    print(\"\\n總結:\", \"全部 PASS：手刻 PCA 與 sklearn PCA 一致\" if all_pass else \"部分 FAIL\")\n\n\nif __name__ == \"__main__\":\n    verify()","lineStart":1,"lineEnd":113,"totalLines":113,"truncated":false}},"title":"Users\\User\\Documents\\ai-math-refresh-20260912\\agent-workflow-auto\\lab2_pca.py","time":{"start":1789228517048,"end":1789228517054}},"id":"prt_0965485f5001LCgPf99yHZ2eCO","sessionID":"ses_f69abb172ffeDarDKAA7BOMHKQ","messageID":"msg_096547a0d0018uvUb5CIL0MrsD"}}
{"type":"tool_use","timestamp":1789228517313,"sessionID":"ses_f69abb172ffeDarDKAA7BOMHKQ","part":{"type":"tool","tool":"read","callID":"call_5cbeff4f34cc42c28e91c2f3","state":{"status":"completed","input":{"filePath":"C:\\Users\\User\\Documents\\ai-math-refresh-20260912\\agent-workflow-auto\\lab3_logistic.py"},"output":"<path>C:\\Users\\User\\Documents\\ai-math-refresh-20260912\\agent-workflow-auto\\lab3_logistic.py</path>\n<type>file</type>\n<content>\n1: import numpy as np\n2: from sklearn.datasets import load_digits\n3: \n4: \n5: def sigmoid(z):\n6:     out = np.empty_like(z)\n7:     pos = z >= 0\n8:     out[pos] = 1.0 / (1.0 + np.exp(-z[pos]))\n9:     out[~pos] = np.exp(z[~pos]) / (1.0 + np.exp(z[~pos]))\n10:     return out\n11: \n12: \n13: def softplus(z):\n14:     return np.maximum(z, 0.0) + np.log1p(np.exp(-np.abs(z)))\n15: \n16: \n17: def loss(w, Xb, y):\n18:     z = Xb @ w\n19:     return np.mean(softplus(z) - y * z)\n20: \n21: \n22: def grad(w, Xb, y):\n23:     p = sigmoid(Xb @ w)\n24:     return Xb.T @ (p - y) / Xb.shape[0]\n25: \n26: \n27: def finite_diff_grad(w, Xb, y, h):\n28:     g = np.zeros_like(w)\n29:     for j in range(w.size):\n30:         wp = w.copy()\n31:         wm = w.copy()\n32:         wp[j] += h\n33:         wm[j] -= h\n34:         g[j] = (loss(wp, Xb, y) - loss(wm, Xb, y)) / (2.0 * h)\n35:     return g\n36: \n37: \n38: digits = load_digits()\n39: mask = (digits.target == 3) | (digits.target == 8)\n40: X = digits.data[mask] / 16.0\n41: y = (digits.target[mask] == 8).astype(float)\n42: Xb = np.column_stack([X, np.ones(X.shape[0])])\n43: \n44: print(\"X shape  =\", X.shape)\n45: print(\"y shape  =\", y.shape)\n46: print(\"Xb shape =\", Xb.shape)\n47: print(\"d =\", Xb.shape[1], \"(64 features + 1 intercept)\")\n48: \n49: w0 = np.random.RandomState(0).normal(size=Xb.shape[1]) * 0.01\n50: g_analytic = grad(w0, Xb, y)\n51: \n52: print()\n53: print(\"central-difference gradient check over ALL 65 dims,\")\n54: print(\"checkpoint w0 = np.random.RandomState(0).normal(size=65) * 0.01\")\n55: print()\n56: print(f\"{'h':>8}  {'max |fd - analytic|':>20}  {'max |rel err|':>14}\")\n57: print(\"-\" * 52)\n58: for p in range(2, 10):\n59:     h = 10.0 ** (-p)\n60:     g_fd = finite_diff_grad(w0, Xb, y, h)\n61:     abs_err = np.abs(g_fd - g_analytic)\n62:     rel_err = abs_err / np.maximum(np.abs(g_analytic), 1e-12)\n63:     print(f\"{h:8.1e}  {abs_err.max():20.3e}  {rel_err.max():14.3e}\")\n\n(End of file - total 63 lines)\n</content>","metadata":{"preview":"import numpy as np\nfrom sklearn.datasets import load_digits\n\n\ndef sigmoid(z):\n    out = np.empty_like(z)\n    pos = z >= 0\n    out[pos] = 1.0 / (1.0 + np.exp(-z[pos]))\n    out[~pos] = np.exp(z[~pos]) / (1.0 + np.exp(z[~pos]))\n    return out\n\n\ndef softplus(z):\n    return np.maximum(z, 0.0) + np.log1p(np.exp(-np.abs(z)))\n\n\ndef loss(w, Xb, y):\n    z = Xb @ w\n    return np.mean(softplus(z) - y * z)\n","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\Users\\User\\Documents\\ai-math-refresh-20260912\\agent-workflow-auto\\lab3_logistic.py","text":"import numpy as np\nfrom sklearn.datasets import load_digits\n\n\ndef sigmoid(z):\n    out = np.empty_like(z)\n    pos = z >= 0\n    out[pos] = 1.0 / (1.0 + np.exp(-z[pos]))\n    out[~pos] = np.exp(z[~pos]) / (1.0 + np.exp(z[~pos]))\n    return out\n\n\ndef softplus(z):\n    return np.maximum(z, 0.0) + np.log1p(np.exp(-np.abs(z)))\n\n\ndef loss(w, Xb, y):\n    z = Xb @ w\n    return np.mean(softplus(z) - y * z)\n\n\ndef grad(w, Xb, y):\n    p = sigmoid(Xb @ w)\n    return Xb.T @ (p - y) / Xb.shape[0]\n\n\ndef finite_diff_grad(w, Xb, y, h):\n    g = np.zeros_like(w)\n    for j in range(w.size):\n        wp = w.copy()\n        wm = w.copy()\n        wp[j] += h\n        wm[j] -= h\n        g[j] = (loss(wp, Xb, y) - loss(wm, Xb, y)) / (2.0 * h)\n    return g\n\n\ndigits = load_digits()\nmask = (digits.target == 3) | (digits.target == 8)\nX = digits.data[mask] / 16.0\ny = (digits.target[mask] == 8).astype(float)\nXb = np.column_stack([X, np.ones(X.shape[0])])\n\nprint(\"X shape  =\", X.shape)\nprint(\"y shape  =\", y.shape)\nprint(\"Xb shape =\", Xb.shape)\nprint(\"d =\", Xb.shape[1], \"(64 features + 1 intercept)\")\n\nw0 = np.random.RandomState(0).normal(size=Xb.shape[1]) * 0.01\ng_analytic = grad(w0, Xb, y)\n\nprint()\nprint(\"central-difference gradient check over ALL 65 dims,\")\nprint(\"checkpoint w0 = np.random.RandomState(0).normal(size=65) * 0.01\")\nprint()\nprint(f\"{'h':>8}  {'max |fd - analytic|':>20}  {'max |rel err|':>14}\")\nprint(\"-\" * 52)\nfor p in range(2, 10):\n    h = 10.0 ** (-p)\n    g_fd = finite_diff_grad(w0, Xb, y, h)\n    abs_err = np.abs(g_fd - g_analytic)\n    rel_err = abs_err / np.maximum(np.abs(g_analytic), 1e-12)\n    print(f\"{h:8.1e}  {abs_err.max():20.3e}  {rel_err.max():14.3e}\")","lineStart":1,"lineEnd":63,"totalLines":63,"truncated":false}},"title":"Users\\User\\Documents\\ai-math-refresh-20260912\\agent-workflow-auto\\lab3_logistic.py","time":{"start":1789228517299,"end":1789228517311}},"id":"prt_0965486f60013p7fU1DYPEFwf4","sessionID":"ses_f69abb172ffeDarDKAA7BOMHKQ","messageID":"msg_096547a0d0018uvUb5CIL0MrsD"}}
