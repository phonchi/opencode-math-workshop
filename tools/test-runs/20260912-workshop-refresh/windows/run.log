{"type":"tool_use","timestamp":1789228703057,"sessionID":"ses_f69a8bb86ffeUProqRItDzMomZ","part":{"type":"tool","tool":"read","callID":"call_bdb8fbb5be084855ade1e799","state":{"status":"completed","input":{"filePath":"C:\\Users\\User\\Documents\\ai-math-refresh-20260912\\agent-workflow-auto\\lab3_logistic.py"},"output":"<path>C:\\Users\\User\\Documents\\ai-math-refresh-20260912\\agent-workflow-auto\\lab3_logistic.py</path>\n<type>file</type>\n<content>\n1: import numpy as np\n2: from sklearn.datasets import load_digits\n3: \n4: \n5: def sigmoid(z):\n6:     out = np.empty_like(z)\n7:     pos = z >= 0\n8:     out[pos] = 1.0 / (1.0 + np.exp(-z[pos]))\n9:     out[~pos] = np.exp(z[~pos]) / (1.0 + np.exp(z[~pos]))\n10:     return out\n11: \n12: \n13: def softplus(z):\n14:     return np.maximum(z, 0.0) + np.log1p(np.exp(-np.abs(z)))\n15: \n16: \n17: def loss(w, Xb, y):\n18:     z = Xb @ w\n19:     return np.mean(softplus(z) - y * z)\n20: \n21: \n22: def grad(w, Xb, y):\n23:     p = sigmoid(Xb @ w)\n24:     return Xb.T @ (p - y) / Xb.shape[0]\n25: \n26: \n27: def finite_diff_grad(w, Xb, y, h):\n28:     g = np.zeros_like(w)\n29:     for j in range(w.size):\n30:         wp = w.copy()\n31:         wm = w.copy()\n32:         wp[j] += h\n33:         wm[j] -= h\n34:         g[j] = (loss(wp, Xb, y) - loss(wm, Xb, y)) / (2.0 * h)\n35:     return g\n36: \n37: \n38: digits = load_digits()\n39: mask = (digits.target == 3) | (digits.target == 8)\n40: X = digits.data[mask] / 16.0\n41: y = (digits.target[mask] == 8).astype(float)\n42: Xb = np.column_stack([X, np.ones(X.shape[0])])\n43: \n44: print(\"X shape  =\", X.shape)\n45: print(\"y shape  =\", y.shape)\n46: print(\"Xb shape =\", Xb.shape)\n47: print(\"d =\", Xb.shape[1], \"(64 features + 1 intercept)\")\n48: \n49: w0 = np.random.RandomState(0).normal(size=Xb.shape[1]) * 0.01\n50: g_analytic = grad(w0, Xb, y)\n51: \n52: print()\n53: print(\"central-difference gradient check over ALL 65 dims,\")\n54: print(\"checkpoint w0 = np.random.RandomState(0).normal(size=65) * 0.01\")\n55: print()\n56: print(f\"{'h':>8}  {'max |fd - analytic|':>20}  {'max |rel err|':>14}\")\n57: print(\"-\" * 52)\n58: for p in range(2, 10):\n59:     h = 10.0 ** (-p)\n60:     g_fd = finite_diff_grad(w0, Xb, y, h)\n61:     abs_err = np.abs(g_fd - g_analytic)\n62:     rel_err = abs_err / np.maximum(np.abs(g_analytic), 1e-12)\n63:     print(f\"{h:8.1e}  {abs_err.max():20.3e}  {rel_err.max():14.3e}\")\n\n(End of file - total 63 lines)\n</content>","metadata":{"preview":"import numpy as np\nfrom sklearn.datasets import load_digits\n\n\ndef sigmoid(z):\n    out = np.empty_like(z)\n    pos = z >= 0\n    out[pos] = 1.0 / (1.0 + np.exp(-z[pos]))\n    out[~pos] = np.exp(z[~pos]) / (1.0 + np.exp(z[~pos]))\n    return out\n\n\ndef softplus(z):\n    return np.maximum(z, 0.0) + np.log1p(np.exp(-np.abs(z)))\n\n\ndef loss(w, Xb, y):\n    z = Xb @ w\n    return np.mean(softplus(z) - y * z)\n","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\Users\\User\\Documents\\ai-math-refresh-20260912\\agent-workflow-auto\\lab3_logistic.py","text":"import numpy as np\nfrom sklearn.datasets import load_digits\n\n\ndef sigmoid(z):\n    out = np.empty_like(z)\n    pos = z >= 0\n    out[pos] = 1.0 / (1.0 + np.exp(-z[pos]))\n    out[~pos] = np.exp(z[~pos]) / (1.0 + np.exp(z[~pos]))\n    return out\n\n\ndef softplus(z):\n    return np.maximum(z, 0.0) + np.log1p(np.exp(-np.abs(z)))\n\n\ndef loss(w, Xb, y):\n    z = Xb @ w\n    return np.mean(softplus(z) - y * z)\n\n\ndef grad(w, Xb, y):\n    p = sigmoid(Xb @ w)\n    return Xb.T @ (p - y) / Xb.shape[0]\n\n\ndef finite_diff_grad(w, Xb, y, h):\n    g = np.zeros_like(w)\n    for j in range(w.size):\n        wp = w.copy()\n        wm = w.copy()\n        wp[j] += h\n        wm[j] -= h\n        g[j] = (loss(wp, Xb, y) - loss(wm, Xb, y)) / (2.0 * h)\n    return g\n\n\ndigits = load_digits()\nmask = (digits.target == 3) | (digits.target == 8)\nX = digits.data[mask] / 16.0\ny = (digits.target[mask] == 8).astype(float)\nXb = np.column_stack([X, np.ones(X.shape[0])])\n\nprint(\"X shape  =\", X.shape)\nprint(\"y shape  =\", y.shape)\nprint(\"Xb shape =\", Xb.shape)\nprint(\"d =\", Xb.shape[1], \"(64 features + 1 intercept)\")\n\nw0 = np.random.RandomState(0).normal(size=Xb.shape[1]) * 0.01\ng_analytic = grad(w0, Xb, y)\n\nprint()\nprint(\"central-difference gradient check over ALL 65 dims,\")\nprint(\"checkpoint w0 = np.random.RandomState(0).normal(size=65) * 0.01\")\nprint()\nprint(f\"{'h':>8}  {'max |fd - analytic|':>20}  {'max |rel err|':>14}\")\nprint(\"-\" * 52)\nfor p in range(2, 10):\n    h = 10.0 ** (-p)\n    g_fd = finite_diff_grad(w0, Xb, y, h)\n    abs_err = np.abs(g_fd - g_analytic)\n    rel_err = abs_err / np.maximum(np.abs(g_analytic), 1e-12)\n    print(f\"{h:8.1e}  {abs_err.max():20.3e}  {rel_err.max():14.3e}\")","lineStart":1,"lineEnd":63,"totalLines":63,"truncated":false}},"title":"Users\\User\\Documents\\ai-math-refresh-20260912\\agent-workflow-auto\\lab3_logistic.py","time":{"start":1789228703049,"end":1789228703055}},"id":"prt_096575cac001ybZr4x1IJJ3jAv","sessionID":"ses_f69a8bb86ffeUProqRItDzMomZ","messageID":"msg_0965756c1001agWd5fzYzHRPf4"}}
