    },
    {
      "id": "edit",
      "lane": "main",
      "col": 1,
      "type": "backend",
      "label": "請 agent 修改",
      "width": 160
    },
    {
      "id": "inspect",
      "lane": "main",
      "col": 2,
      "type": "frontend",
      "label": "查看差異並執行",
      "width": 160
    },
    {
      "id": "accept",
      "lane": "main",
      "col": 3,
      "type": "database",
      "label": "確認後 commit",
      "width": 160
