# Python 虛擬環境（幾百 MB，用 uv sync 可重建）
.venv/
__pycache__/
*.pyc

# 圖檔一律不進版控（沿用 selfstudy 系列慣例）
# 參考解答的圖由 reference/*.py 重跑即可產生
tools/test-runs/shots/
*.png
*.jpg
*.jpeg
*.gif

# 作業系統雜物
.DS_Store
Thumbs.db

# 隔離驗證的應用狀態與快取；log、程式與驗證摘要仍保留
tools/test-runs/**/runtime/
tools/test-runs/**/.cache/
tools/test-runs/**/.opencode/node_modules/

# Git 行為測試的巢狀儲存庫；命令與結果已另存 log/JSON
tools/test-runs/**/git-semantics/fixture/
